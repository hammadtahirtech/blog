<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Blog</title>
    <style>
        @import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap");
        @import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap");
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }
        body,
        html {
          overflow-x: hidden;
        }
        ::-webkit-scrollbar {
          width: 7px;
        }
        ::-webkit-scrollbar-thumb {
          background-color: grey;
          border-radius: 10px;
        }
        header .right ul li a:hover + .mouse-background {
          width: 45px;
          height: 45px;
        }
        body {
          font-family: "poppins", sans-serif;
        }
        .blurred {
          filter: blur(2px);
          transition: 0.3s ease-in-out filter;
        }
        header nav {
          background-color: rgb(252, 252, 252);
          color: rgb(0, 0, 0);
          display: flex;
          align-items: center;
          padding: 0px 100px;
          justify-content: space-between;
          height: 70px;
          box-shadow: rgba(17, 17, 26, 0.1) 0px 0px 16px;
          border-bottom: 1px solid rgb(212, 212, 212);
        }
        header nav .left {
          display: flex;
        }
        header nav .left img {
          width: 50px;
          height: 50px;
        }
        header nav .left .menu {
          display: none;
        }
        header nav .left .menu .bars {
          background-color: rgb(0, 0, 0);
          height: 2px;
          width: 35px;
          margin: 6px 0;
          transition: transform 0.4s ease-in-out;
        }
        header nav .right {
          display: flex;
          align-items: flex-end;
          justify-content: end;
        }
        header nav .right ul {
          display: flex;
          gap: 1.5rem;
        }
        header nav .right ul li {
          list-style: none;
        }
        header nav .right ul li a {
          text-decoration: none;
          color: rgb(0, 0, 0);
          transition: all 0.4s ease-in;
        }
        header nav .right ul li a::after {
          content: "";
          width: 0%;
          height: 1px;
          background-color: rgb(0, 0, 0);
          display: block;
          transition: 0.4s width ease-in-out;
        }
        header nav .right ul li a:hover::after {
          width: 90%;
        }
        .add-blog{
          padding: 40px 100px 218px 100px;
        }
        footer {
          background-color: rgb(252, 252, 252);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          padding: 30px 100px;
          box-shadow: rgba(17, 17, 26, 0.1) 0px 0px 16px;
          border-top: 1px solid rgb(212, 212, 212);
          gap: 1.4rem;
        }
        footer .logo img {
          width: 50px;
          height: 50px;
        }
        footer .links ul {
          display: flex;
          gap: 1rem;
        }
        footer .links ul a {
          text-decoration: none;
          color: black;
        }
        footer .links ul li {
          list-style: none;
        }
        footer .links ul a::after {
          content: "";
          width: 0%;
          height: 1px;
          background-color: rgb(0, 0, 0);
          display: block;
          transition: 0.4s width ease-in-out;
        }
        footer .links ul a:hover::after {
          width: 90%;
        }
        footer .footer-text {
          width: 100%;
        }
        footer .footer-text p {
          text-align: center;
        }
      </style>
    </head>
    <body>
      <header>
        <nav class="navbar">
          <div class="left">
            <div class="empty"></div>
            <h2>Add Blog</h2>
            <div class="menu">
              <div class="bars"></div>
              <div class="bars"></div>
              <div class="bars"></div>
            </div>
          </div>
          <div class="right">
            <ul>
              <li><a href="http://localhost:1000">Home</a></li>
            </ul>
          </div>
        </nav>
      </header>
      <div class="add-blog">
        <form action="/pushBlog" method="post">
            <label for="blogName">Blog Name:</label>
            <br>
            <input type="text" name="blogName" style="width: 300px; height: 27px;">
            <br>
            <label for="blogContent">Blog Content:</label>
            <textarea name="blogContent" style="width: 100%; height: 250px; resize: none; padding: 10px; font-size: 1.1rem;"></textarea>
            <button type="submit">submit</button>
        </form>
      </div>
      <footer>
        <div class="logo">
          <h2>Add Blog</h2>
        </div>
        <div class="links">
          <ul>
            <li><a href="http://localhost:1000" id="mouse-big">Home</a></li>
          </ul>
        </div>
        <div class="footer-text">
          <p>
            &copy; 2024 All Rights Reserved by
            <a
              href="mailto:mhammaad.tahir123@gmail.com"
              id="mouse-big"
              style="font-weight: 600; color: black; text-decoration: none"
              >Hammad</a
            >
          </p>
        </div>
      </footer>  
</body>
</html>