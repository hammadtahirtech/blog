    </div>
    <div class="comments">
      <h2>Comments</h2>
      <% comments.forEach(comment => { %>
        <div class="comment">
          <h3><%= comment.username %></h3>
          <p><%= comment.comment %></p>
        </div>
      <% }) %>
      <form action="/comments/blog-1" method="post">
        <textarea name="comment" placeholder="Add comment" style="width: 100%; height: 250px; resize: none; padding: 10px; font-size: 1.1rem;"></textarea>
        <button type="submit">Submit</button>
      </form>
    </div>
    <footer>
      <div class="logo">
        <h2><a href="http://localhost:1000" style="color:black; text-decoration: none;">Home</a></h2>
      </div>
      <div class="links">
        <ul>
          <li><a href="http://localhost:1000/addBlog">Add Blog</a></li>
        </ul>
      </div>
      <div class="footer-text">
        <p>
          &copy; 2024 All Rights Reserved by
          <a
            href="mailto:mhammaad.tahir123@gmail.com"
            id="mouse-big"
            style="font-weight: 600; color: black; text-decoration: none"
            >Hammad</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
